From f4b561daf6fea5704a3511a549e308655b6cfe16 Mon Sep 17 00:00:00 2001
From: Matt Turner <mattst88@gmail.com>
Date: Wed, 25 Feb 2026 08:13:36 -0500
Subject: [PATCH 1/8] config.mk: Disable `WITH_TLS_PSK` when `WITH_TLS` is off

This automatically disables TLS-PSK when TLS is disabled.

Signed-off-by: Matt Turner <mattst88@gmail.com>
---
 config.mk | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/config.mk b/config.mk
index 5c46f0b1bf..1017688f22 100644
--- a/config.mk
+++ b/config.mk
@@ -27,6 +27,9 @@ WITH_TLS:=yes
 # WITH_TLS=yes.
 # This must be disabled if using openssl < 1.0.
 WITH_TLS_PSK:=yes
+ifneq ($(WITH_TLS),yes)
+	override WITH_TLS_PSK:=no
+endif
 
 # Comment out to disable client threading support.
 WITH_THREADING:=yes

